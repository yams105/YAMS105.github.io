                    if (isNaN(dayIdx)) return;
                    const day = appData.days[dayIdx];
                    if (!day) return;
                    const name = prompt('请输入菜品名称：', '新菜品');
                    if (name === null) return;
                    const trimmed = name.trim();
                    if (!trimmed) { showToast('名称不能为空', 'error'); return; }
                    day.items.push({ name: trimmed, total: 0, note: '' });
                    saveAppData();
                    renderApp();
                    showToast(`已添加菜品：${trimmed}`, 'success');
