                        </div>
                        <div class="draft-actions">
                            <button class="btn btn-primary btn-sm load-draft" data-id="${d.id}">📂 加载</button>
                            <button class="btn btn-success btn-sm export-draft" data-id="${d.id}">📥 导出</button>
                            <button class="btn btn-danger btn-sm delete-draft" data-id="${d.id}">🗑️</button>
                        </div>
                    </div>
                `;
            });
            container.innerHTML = html;

            // 绑定事件
            container.querySelectorAll('.load-draft').forEach(btn => {
                btn.onclick = function(e) {
                    e.stopPropagation();
                    const id = this.dataset.id;
                    loadDraft(id);
                };
            });
            container.querySelectorAll('.export-draft').forEach(btn => {
                btn.onclick = function(e) {
                    e.stopPropagation();
                    const id = this.dataset.id;
                    exportDraft(id);
                };
            });
