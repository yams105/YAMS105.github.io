        function saveAppData() {
            if (!appData) return;
            clearTimeout(saveTimeout);
            saveTimeout = setTimeout(() => {
                try {
                    localStorage.setItem(STORAGE_KEY, JSON.stringify(appData));
                } catch (e) {
                    console.warn('保存失败', e);
                }
            }, 150);
