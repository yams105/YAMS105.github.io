            return Date.now().toString(36) + Math.random().toString(36).substr(2, 6);
        }

        function formatTimestamp(ts) {
            const d = new Date(ts);
            return d.toLocaleString('zh-CN', { hour12: false });
        }

        function addDraft(name, data) {
            const draft = {
                id: generateId(),
                name: name || '未命名草稿',
                timestamp: Date.now(),
                data: cloneDeep(data)
            };
            // 如果名称为"自动保存"，查找是否有同名草稿并覆盖
            if (name === '自动保存') {
                const existing = drafts.find(d => d.name === '自动保存');
                if (existing) {
                    existing.data = cloneDeep(data);
                    existing.timestamp = Date.now();
                    saveDrafts();
                    renderDraftList();
                    return existing;
                }
            }
            drafts.push(draft);
            saveDrafts();
            renderDraftList();
            return draft;
        }

        function deleteDraft(id) {
            drafts = drafts.filter(d => d.id !== id);
            saveDrafts();
            renderDraftList();
        }

