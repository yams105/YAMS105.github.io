        // ================================================================
        // 9. 导出 .xlsx 通用函数（支持传入数据）
        // ================================================================
        function exportXlsxData(data, customFileName) {
            if (!data) return;
            // 如果 data 没有 days，视为空
            if (!data.days) data.days = [];
            // 确保必要字段
            const school = data.school || '尚湖初中';
            const week = data.week || '第2周';
            const dateRange = data.dateRange || '9月7日 — 9月11日';
            const contact = data.contact || '王亚俐';
            const phone = data.phone || '528939';
            const unit = data.unit || '斤';
            const days = data.days || [];
            const sRatio = data.ratioStudent || 7;
            const tRatio = data.ratioTeacher || 1;

            // 动态加载库
            const script = document.createElement('script');
            script.src = 'https://cdn.jsdelivr.net/npm/xlsx-js-style@1.2.0/dist/xlsx.bundle.js';
            script.onload = function() {
                doExport(true);
            };
            script.onerror = function() {
                const fallback = document.createElement('script');
                fallback.src = 'https://cdn.sheetjs.com/xlsx-0.20.1/package/dist/xlsx.full.min.js';
                fallback.onload = function() {
                    doExport(false);
                };
                fallback.onerror = function() {
                    showToast('加载导出库失败，请检查网络', 'error');
                };
                document.head.appendChild(fallback);
            };
            document.head.appendChild(script);

            function doExport(supportStyle) {
                try {
                    const wb = XLSX.utils.book_new();
                    const rows = [];
                    const colCount = 26;

                    // 标题
                    const titleStr = `${school} ${week} 食品订单（${dateRange}）`;
                    const titleRow = Array(colCount).fill('');
                    titleRow[0] = titleStr;
                    rows.push(titleRow);

                    // 信息行
                    const infoStr =
                        `学校：${school} 经办人：${contact} 联系电话：${phone} 单位：${unit}`;
                    const infoRow = [infoStr, ...Array(colCount - 1).fill('')];
                    rows.push(infoRow);

                    // 日期行
                    const weekRow = ['序号'];
                    const dayNames = days.map(d => d.name || '');
                    while (dayNames.length < 5) dayNames.push('');
                    dayNames.forEach(name => {
                        weekRow.push(name, '', '', '', '');
                    });
                    while (weekRow.length < colCount) weekRow.push('');
                    rows.push(weekRow);

                    // 表头1
                    const headerRow1 = [''];
                    dayNames.forEach(() => {
                        headerRow1.push('品名', '', '', '', '备注');
                    });
                    while (headerRow1.length < colCount) headerRow1.push('');
                    rows.push(headerRow1);

                    // 表头2
                    const headerRow2 = [''];
                    dayNames.forEach(() => {
                        headerRow2.push('', '学生', '老师', '合计', '');
                    });
                    while (headerRow2.length < colCount) headerRow2.push('');
                    rows.push(headerRow2);

                    // 数据
                    let maxItems = 0;
                    days.forEach(day => {
                        if (day.items && day.items.length > maxItems) maxItems = day.items.length;
                    });
                    if (maxItems === 0) maxItems = 1;

                    for (let i = 0; i < maxItems; i++) {
                        const rowData = [i + 1];
                        days.forEach((day) => {
                            const items = day.items || [];
                            if (i < items.length) {
                                const item = items[i];
                                const total = item.total || 0;
                                const { student, teacher } = calcStudentTeacher(total, sRatio, tRatio);
                                rowData.push(
                                    item.name || '',
                                    Math.round(student * 100) / 100,
                                    Math.round(teacher * 100) / 100,
                                    total,
                                    item.note || ''
                                );
                            } else {
                                rowData.push('', '', '', '', '');
                            }
                        });
                        while (rowData.length < colCount) rowData.push('');
                        rows.push(rowData);
                    }

                    const ws = XLSX.utils.aoa_to_sheet(rows);

                    // 合并单元格
                    const merges = [];
                    merges.push({ s: { r: 0, c: 0 }, e: { r: 0, c: colCount - 1 } });
                    merges.push({ s: { r: 1, c: 0 }, e: { r: 1, c: colCount - 1 } });
                    const dayStartCol = 1;
                    days.forEach((day, idx) => {
                        const startC = dayStartCol + idx * 5;
                        const endC = startC + 4;
                        merges.push({ s: { r: 2, c: startC }, e: { r: 2, c: endC } });
                    });
                    ws['!merges'] = merges;

                    // 列宽
                    const colWidths = [];
                    colWidths[0] = { wch: 6 };
                    for (let i = 0; i < 5; i++) {
                        colWidths.push({ wch: 12 });
                        colWidths.push({ wch: 8 });
                        colWidths.push({ wch: 8 });
                        colWidths.push({ wch: 8 });
                        colWidths.push({ wch: 12 });
                    }
                    ws['!cols'] = colWidths;

                    // 样式
                    if (supportStyle && typeof XLSX.utils.sheet_add_aoa === 'function' && ws['!rows'] !== undefined) {
                        const range = XLSX.utils.decode_range(ws['!ref']);
                        for (let R = range.s.r; R <= range.e.r; R++) {
                            for (let C = range.s.c; C <= range.e.c; C++) {
                                const addr = XLSX.utils.encode_cell({ r: R, c: C });
                                if (!ws[addr]) continue;
                                if (!ws[addr].s) ws[addr].s = {};
                                ws[addr].s.alignment = { horizontal: 'center', vertical: 'center' };
                                ws[addr].s.border = {
                                    top: { style: 'thin' },
                                    bottom: { style: 'thin' },
                                    left: { style: 'thin' },
                                    right: { style: 'thin' }
                                };
                            }
                        }
                        merges.forEach(m => {
                            for (let R = m.s.r; R <= m.e.r; R++) {
                                for (let C = m.s.c; C <= m.e.c; C++) {
                                    const addr = XLSX.utils.encode_cell({ r: R, c: C });
                                    if (!ws[addr]) continue;
                                    if (!ws[addr].s) ws[addr].s = {};
                                    ws[addr].s.alignment = { horizontal: 'center', vertical: 'center' };
                                    ws[addr].s.border = {
                                        top: { style: 'thin' },
                                        bottom: { style: 'thin' },
                                        left: { style: 'thin' },
                                        right: { style: 'thin' }
                                    };
                                }
                            }
                        });
                    }

                    XLSX.utils.book_append_sheet(wb, ws, 'Sheet1');
                    const fileName = customFileName ?
                        `${customFileName}.xlsx` :
                        `${school}_食品订单_${dateRange}.xlsx`;
                    XLSX.writeFile(wb, fileName);
                    showToast(`导出成功：${fileName}`, 'success');
                } catch (e) {
                    console.error(e);
                    showToast('导出失败：' + e.message, 'error');
                }
            }
        }

        // ================================================================
        // 10. Toast
        // ================================================================
        function showToast(msg, type) {
            const el = document.getElementById('toast');
            el.textContent = msg;
            el.className = 'toast ' + (type || '');
            void el.offsetWidth;
            el.classList.add('show');
            clearTimeout(el._hideTimer);
            el._hideTimer = setTimeout(() => {
                el.classList.remove('show');
            }, 2200);
        }

        // ================================================================
        // 11. 初始化
        // ================================================================
        renderSampleData();
        loadAppData();
        loadDrafts();
        renderApp();
        saveAppData();

        // 绑定周数和日期范围的双击编辑
        (function bindWeekAndDateEdit() {
            const weekEl = document.getElementById('weekDisplay');
            const dateEl = document.getElementById('dateDisplay');

            weekEl.addEventListener('dblclick', function(e) {
                e.stopPropagation();
                const current = appData.week || '第2周';
                const newVal = prompt('请输入周数（如：第2周）：', current);
                if (newVal !== null && newVal.trim() !== '') {
                    appData.week = newVal.trim();
                    saveAppData();
                    renderApp();
                    showToast('周数已更新', 'success');
                } else if (newVal !== null && newVal.trim() === '') {
                    showToast('周数不能为空', 'error');
                }
            });

            dateEl.addEventListener('dblclick', function(e) {
                e.stopPropagation();
                const current = appData.dateRange || '9月7日 — 9月11日';
                const newVal = prompt('请输入日期范围（如：9月7日 — 9月11日）：', current);
                if (newVal !== null && newVal.trim() !== '') {
                    appData.dateRange = newVal.trim();
                    saveAppData();
                    renderApp();
                    showToast('日期范围已更新', 'success');
                } else if (newVal !== null && newVal.trim() === '') {
                    showToast('日期范围不能为空', 'error');
                }
            });
        })();

        window.addEventListener('beforeunload', function() {
            saveAppData();
            // 最后自动保存一次
            if (appData && appData.days && appData.days.length > 0) {
                addDraft('自动保存', appData);
            }
        });

        console.log('✅ 智能体表格已启动，草稿箱功能已启用，自动保存每30秒一次，数据保存在 localStorage');
        console.log('📊 当前智能体数据：', appData);
    </script>
</body>
</html>
