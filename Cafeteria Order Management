                    if (confirm('确定删除该草稿吗？')) {
                        deleteDraft(id);
                        showToast('草稿已删除', 'success');
                    }
                };
            });
        }

        function escapeHtml(str) {
            if (!str) return '';
            return String(str).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        }

        // ================================================================
        // 4. 计算工具
        // ================================================================
        function calcStudentTeacher(total, sRatio, tRatio) {
            if (total === undefined || total === null || isNaN(total)) return { student: 0, teacher: 0 };
            const num = parseFloat(total);
            if (isNaN(num) || num < 0) return { student: 0, teacher: 0 };
            const sum = sRatio + tRatio;
            if (sum === 0) return { student: 0, teacher: 0 };
            const student = (num * sRatio) / sum;
            const teacher = (num * tRatio) / sum;
            return {
                student: Math.round(student * 100) / 100,
                teacher: Math.round(teacher * 100) / 100
            };
        }

