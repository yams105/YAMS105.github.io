        // ================================================================
        // 8. 事件绑定（智能体）
        // ================================================================
        function bindAllEvents() {
            const container = document.getElementById('daysContainer');

            // 合计输入
            container.querySelectorAll('.item-total').forEach(inp => {
                inp.oninput = function() {
                    const tr = this.closest('tr');
                    if (!tr) return;
                    const dayIdx = parseInt(tr.dataset.dayIdx);
                    const itemIdx = parseInt(tr.dataset.itemIdx);
                    if (isNaN(dayIdx) || isNaN(itemIdx)) return;
                    const day = appData.days[dayIdx];
                    if (!day) return;
                    const item = day.items[itemIdx];
                    if (!item) return;

                    const val = parseFloat(this.value);
                    const total = isNaN(val) ? 0 : val;
                    item.total = total;

                    const sRatio = appData.ratioStudent || 7;
                    const tRatio = appData.ratioTeacher || 1;
                    const { student, teacher } = calcStudentTeacher(total, sRatio, tRatio);
                    const studentSpan = tr.querySelector('.student-val');
                    const teacherSpan = tr.querySelector('.teacher-val');
                    if (studentSpan) studentSpan.textContent = student;
                    if (teacherSpan) teacherSpan.textContent = teacher;

                    saveAppData();
                };
            });

            // 品名变更
            container.querySelectorAll('.item-name').forEach(inp => {
                inp.onchange = function() {
                    const tr = this.closest('tr');
                    if (!tr) return;
                    const dayIdx = parseInt(tr.dataset.dayIdx);
                    const itemIdx = parseInt(tr.dataset.itemIdx);
                    if (isNaN(dayIdx) || isNaN(itemIdx)) return;
                    const day = appData.days[dayIdx];
                    if (!day) return;
                    const item = day.items[itemIdx];
                    if (!item) return;
                    item.name = this.value.trim() || '未命名';
                    saveAppData();
                };
            });

            // 备注变更
            container.querySelectorAll('.item-note').forEach(inp => {
                inp.onchange = function() {
                    const tr = this.closest('tr');
                    if (!tr) return;
                    const dayIdx = parseInt(tr.dataset.dayIdx);
                    const itemIdx = parseInt(tr.dataset.itemIdx);
                    if (isNaN(dayIdx) || isNaN(itemIdx)) return;
                    const day = appData.days[dayIdx];
                    if (!day) return;
                    const item = day.items[itemIdx];
                    if (!item) return;
                    item.note = this.value.trim() || '';
                    saveAppData();
                };
            });

            // 删除菜品
            container.querySelectorAll('.remove-item-btn').forEach(btn => {
                btn.onclick = function(e) {
                    e.stopPropagation();
                    const dayIdx = parseInt(this.dataset.dayidx);
                    const itemIdx = parseInt(this.dataset.itemidx);
                    if (isNaN(dayIdx) || isNaN(itemIdx)) return;
                    if (!confirm('确定删除该菜品吗？')) return;
                    const day = appData.days[dayIdx];
                    if (!day) return;
                    day.items.splice(itemIdx, 1);
                    saveAppData();
                    renderApp();
                    showToast('已删除菜品', 'success');
                };
            });

            // 删除天
            container.querySelectorAll('.remove-day-btn').forEach(btn => {
                btn.onclick = function(e) {
                    e.stopPropagation();
                    const dayIdx = parseInt(this.dataset.dayidx);
                    if (isNaN(dayIdx)) return;
                    if (appData.days.length <= 1) {
                        showToast('至少保留一天', 'error');
                        return;
                    }
                    if (!confirm(`确定删除 "${appData.days[dayIdx].name}" 及其所有数据吗？`)) return;
                    appData.days.splice(dayIdx, 1);
                    saveAppData();
                    renderApp();
                    showToast('已删除', 'success');
                };
            });

            // 添加菜品（通过标题按钮）
